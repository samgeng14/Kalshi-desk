# deskd recorder settings: /etc/deskd-recorder/recorder.env (setup.sh installs this file only
# where none exists). Not secret: the key, the R2 token and the healthchecks.io URLs go in
# /etc/deskd-recorder/credentials/ (README.md, "On the VM").
#
# Comments go on their own lines: systemd keeps a "# ..." after a value as part of the value.
#
# Kalshi's production market data, on a READ-ONLY API key (create it in Kalshi with read access
# only; never the trading key). The recorder sends GETs and socket subscriptions, nothing else.
KALSHI_REST=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS=wss://api.elections.kalshi.com/trade-api/ws/v2
REC_DATA_DIR=/var/lib/deskd-recorder
# the series whose books, trades and strikes it records (default: the ten 15-minute financial
# series and five weather cities)
#REC_BOOK_SERIES=KXGOLD15M,KXSILVER15M,KXWTI15M,KXNATGAS15M,KXCOPPER15M,KXPLATINUM15M,KXPALLADIUM15M,KXEURUSD15M,KXGBPUSD15M,KXUSDJPY15M,KXHIGHNY,KXHIGHCHI,KXHIGHMIA,KXHIGHAUS,KXHIGHLAX
# subscribe a window this long before it opens, and keep it this long after it closes
#REC_LEAD_S=1200
#REC_LINGER_S=300
#REC_DISCOVER_S=30
#REC_SETTLED_S=300
#
# ---- plan 5(d): college and thin-sport games ---------------------------------------------------
# Every game of these series is recorded: books and trades on the socket (the same lead/linger
# rules), the books by REST every few seconds, lifecycle, and the scores below. Listed hourly.
# TO CONFIRM each ticker on kalshi.com before Nov 2 (a wrong one lists nothing and records
# nothing; it does no harm). Best guesses, and where each came from:
#   KXNCAAWBGAME      women's college basketball     deskd's ref/espn.cpp, docs/edge_results.json
#   KXNCAAWVMATCH     women's college volleyball     docs/edge_results.json (275 matches Sep-Oct 2026)
#   KXNCAAHOCKEYGAME  college hockey                 docs/edge_results.json (last season)
#   KXTTSTARMATCH     table tennis, TT Star Series   the demo's listing; other table tennis series?
#   KXAHLGAME         AHL                            a guess from the naming
#   KXLIIGAGAME       Liiga                          docs/edge_results.json (83 events Sep-Oct 2026)
#   KXSHLGAME         SHL                            a guess
#   KXCS2GAME         CS2                            a guess (may be per map or per match)
#REC_COLLEGE_SERIES=KXNCAAWBGAME,KXNCAAWVMATCH,KXNCAAHOCKEYGAME,KXTTSTARMATCH,KXAHLGAME,KXLIIGAGAME,KXSHLGAME,KXCS2GAME
# the control: men's college basketball (TO CONFIRM the ticker), only its thinnest tenth by
# pregame volume, picked at REC_CONTROL_PICK_UTC_H (15 UTC = 10-11 ET) and kept for the day
#REC_CONTROL_SERIES=KXNCAAMBGAME
#REC_CONTROL_FRAC=0.1
#REC_CONTROL_PICK_UTC_H=15
#REC_COLLEGE_DISCOVER_S=3600
# market_lifecycle_v2 on the recorded markets and the college games (an explicit list); 0: off
#REC_LIFECYCLE=1
#
# ---- the game group: the NBA ---------------------------------------------------------------------
# Every game listed hourly, its books and trades on the socket (and lifecycle) only inside the game's
# window: REC_GAME_PRE_S before its scheduled start to REC_LINGER_S after its market closes; never
# by REST unless the fallback is on. 'off': none. The scheduled start is occurrence_datetime - 3 h
# (TO CONFIRM on the first night's kalshi_markets rows), else 10:00 ET on the ticker's date.
#REC_GAME_SERIES=KXNBAGAME
#REC_GAME_PRE_S=7200
#
# ---- public REST: two budgets under the read-only key, 10 requests a second together -----------
# discovery, trade backfill, incentives and the daily listing; and the REST books
#REC_REST_RPS=5
#REC_REST_BOOK_RPS=5
# every college market's top of book this often (3-5 s), and its whole book while its top moved
# this recently
#REC_REST_BOOK_S=4
#REC_REST_BOOK_HOT_S=300
# the socket's books missing this long: REST reads the book series' books too (the fallback)
#REC_REST_FALLBACK_S=300
# trades by REST over the last hour this often (and after every disconnect, gap or restart)
#REC_BACKFILL_S=3600
# incentive programs hourly, the types kept chosen here (the venue ignores its own type filter)
#REC_INCENTIVES_S=3600
#REC_INCENTIVE_TYPES=liquidity,volume
#REC_INCENTIVE_STATUS=active
# every open market once a day, at or after this UTC hour
#REC_MARKETS_DAILY_UTC_H=12
#REC_MARKETS_DAILY_PAGES=500
#
# ---- scores: each change once, with the local time it was first seen -------------------------
# ESPN 'sport/league[:groups]' (groups=50 is Division I for basketball). TO CONFIRM the volleyball
# and hockey league paths; ESPN carries no AHL, Liiga, SHL, CS2 or table tennis. basketball/nba is
# the game group's. 'off': none.
#REC_ESPN_URL=https://site.api.espn.com/apis/site/v2/sports
#REC_ESPN_LEAGUES=basketball/womens-college-basketball:50,basketball/mens-college-basketball:50,volleyball/womens-college-volleyball,hockey/mens-college-hockey,basketball/nba
# NCAA.com's scoreboard JSON (unofficial, undocumented): TO CONFIRM the URL and the sport names
#REC_NCAA_URL=https://data.ncaa.com/casablanca/scoreboard
#REC_NCAA_SPORTS=basketball-women/d1,basketball-men/d1,volleyball-women/d1,icehockey-men/d1
# polled this often while a game is on (or within 15 minutes of its start), and otherwise
#REC_SCORES_S=4
#REC_SCORES_IDLE_S=60
# a game in progress whose clock moved gets a row at most this often (0: the clock alone never)
#REC_SCORES_CLOCK_S=30
# ESPN leagues whose scoreboard's last play is a change (its win probability on every play);
# and whose games in progress have their summary (play-by-play) read this often into espn_plays.
# TO CONFIRM the NBA board and summary shapes on the first night (the test fixtures are hand-built).
#REC_PLAY_DIGEST_LEAGUES=basketball/nba
#REC_SUMMARY_LEAGUES=basketball/nba
#REC_SUMMARY_S=10
#
# uploads (recorder/upload.py)
REC_R2_PREFIX=archive/recorder
REC_KEEP_DAYS=14
REC_DISK_ALERT=0.70
