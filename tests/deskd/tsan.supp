# ThreadSanitizer suppressions for deskd's TSan build (-DDESKD_TSAN=ON); ctest passes this file
# to deskd-soak, and by hand: TSAN_OPTIONS=suppressions=tests/deskd/tsan.supp
#
# OpenSSL is not built with TSan. Its SSL_SESSION reference counts are atomics inside libcrypto
# that TSan cannot see, so a session one connection read and released (a TLS 1.3 ticket arriving
# on a resumed session: OpenSSL duplicates the shared session rather than change it) and another
# connection then freed (the session cache replacing it, net/conn.cpp) is reported as a race on
# the session's certificate stack. Both are libcrypto's own stack routines; a deskd frame racing
# on its own data is still reported.
race:OPENSSL_sk_dup
race:OPENSSL_sk_free
