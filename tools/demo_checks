#!/bin/sh
# Plan section 9's Kalshi demo checks in one run, on the demo account (play money) only:
# kalshi-demo-probe's order check, order-group check, venue checks (duplicate client_order_id,
# shortest expiry, reduce_only, post-only at the ask, self-trade both ways) and feeds check. The
# probe refuses a production host and a key file whose env is not demo before anything connects.
#
#   tools/demo_checks                      # ~/.kalshi/demo.json
#   tools/demo_checks --key FILE --order-ticker T
#
# The venue's raw replies, the checks' report (kalshi_demo_venue_checks.json) and the printout go
# to demo-checks/<UTC time>/. Look the replies over for account ids before committing any as a
# fixture. Exit 0 when every check is OK.
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
probe="$root/build-deskd/kalshi-demo-probe"
if [ ! -x "$probe" ]; then
  echo "demo_checks: no $probe; build it: cmake -S . -B build-deskd -G Ninja && ninja -C build-deskd kalshi-demo-probe" >&2
  exit 2
fi
out="$root/demo-checks/$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$out"
{ "$probe" --handshakes 2 --order-check --group-check --venue-checks --feeds-check --dump "$out" "$@"; echo $? > "$out/exit"; } 2>&1 |
  tee "$out/probe.txt"
rc=$(cat "$out/exit" 2>/dev/null || echo 1)
echo "demo_checks: exit $rc; replies and report in $out"
exit "$rc"
